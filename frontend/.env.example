# Browser API base. Default is the same-origin root /api/v1, independent of # routes.
VITE_API_BASE_URL=/api/v1
# Vite DEVELOPMENT proxy only; never interpreted as a production backend address.
API_PROXY_TARGET=http://127.0.0.1:8000
# For isolated PR #28 integration testing, explicitly override the development
# target to http://127.0.0.1:8010. This is not a production URL.
# API_PROXY_TARGET=http://127.0.0.1:8010
# Start that backend with its own trusted NASA paths, LUNAR_ENABLE_JOBS=1 and a
# private LUNAR_JOB_DB outside the repository. Never put secrets or file paths in
# VITE_* browser configuration. Missing files disable live research, not the UI.
